{
  "name": "b2bforcorporates-backend",
  "version": "1.0.0",
  "description": "B2BForCorporates Backend API",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/workers/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "test": "npm run build && node dist/tests/run.js",
    "db:init": "node dist/config/init.js",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:check": "tsx src/scripts/checkDb.ts",
    "db:reset-password": "tsx src/scripts/resetPassword.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@google/genai": "^2.24.0",
    "@sentry/node": "^10.46.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.33",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^9.0.8",
    "bcryptjs": "2.4.3",
    "body-parser": "1.20.2",
    "bullmq": "^5.71.1",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.22.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "9.0.2",
    "mysql2": "^3.24.5",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.11",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.2",
    "typescript": "^5.9.3",
    "uuid": "9.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
