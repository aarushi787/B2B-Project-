# Template for the Render environment (committed, placeholders only). The real file is backend/.env.render (git-ignored).
# See DEPLOY.md for what each value does.
# --- Behaviour ---
NODE_ENV=production
NODE_VERSION=20
AUTO_INIT_DB=true

# --- Browser access: your Vercel origins, comma-separated, https, NO trailing slash.
# The * matches one hostname segment, so it covers only your own Vercel preview deployments.
CORS_ORIGIN=https://b2-b-project-theta.vercel.app,https://b2-b-project-*-guptaaarushi592-1933s-projects.vercel.app
# Used in verification / password-reset emails (your main Vercel URL)
FRONTEND_URL=https://b2-b-project-theta.vercel.app

# --- Vercel proxies /api to Render: first-party cookies and two proxy hops
COOKIE_SAMESITE=lax
TRUST_PROXY_HOPS=2

DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DBNAME?ssl={"rejectUnauthorized":true}
JWT_SECRET=generate-with-openssl-rand-hex-32
DATA_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32-and-never-change-it
